# ==============================================================================
# Food-System Environment Variables Template
# ==============================================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development

# Laragon MySQL Connection URL
# Standard Laragon default: host localhost:3306, user 'root', empty password
DATABASE_URL="mysql://root:@localhost:3306/food_system"

# Frontend Origin URL (for CORS and Stripe Redirects)
FRONTEND_URL="http://localhost:3000"

# Stripe Test Mode API Keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_placeholder_replace_with_yours"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_secret_for_local_cli"
STRIPE_PRICE_ID=""

# Default Demo User
DEMO_USER_EMAIL="demo@foodsystem.test"

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_replace_with_yours"
